generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TENANT
}

enum PropertyType {
  HOUSE
  APARTMENT
  FLAT
  BUILDING
  COMMERCIAL
  ROOMS_PG
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  INACTIVE
}

enum TenancyStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  APPLIANCE
  STRUCTURAL
  CLEANING
  OTHER
}

enum MaintenancePriority {
  LOW
  NORMAL
  URGENT
}

enum MaintenanceStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentCategory {
  RENTAL_AGREEMENT
  RECEIPT
  OTHER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum NotificationStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownerProfile  OwnerProfile?
  tenantProfile TenantProfile?
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OwnerProfile {
  id         String          @id @default(cuid())
  userId     String          @unique
  fullName   String
  phone      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  properties Property[]
  tenants    TenantProfile[] @relation("OwnerTenants")
  notices    Notice[]
  activities ActivityLog[]
}

model TenantProfile {
  id               String       @id @default(cuid())
  userId           String?      @unique
  ownerId          String
  fullName         String
  phone            String
  email            String?
  alternatePhone   String?
  emergencyContact String?
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  owner            OwnerProfile @relation("OwnerTenants", fields: [ownerId], references: [id], onDelete: Restrict)
  tenancies        Tenancy[]

  @@index([ownerId, archivedAt])
  @@index([phone])
}

model Property {
  id         String       @id @default(cuid())
  ownerId    String
  name       String
  type       PropertyType
  address    String
  city       String
  state      String
  pinCode    String
  photoKey   String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  owner      OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  units      Unit[]
  notices    Notice[]

  @@index([ownerId, archivedAt])
}

model Unit {
  id          String     @id @default(cuid())
  propertyId  String
  name        String
  defaultRent Decimal    @db.Decimal(12, 2)
  status      UnitStatus @default(VACANT)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenancies   Tenancy[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
}

model Tenancy {
  id                  String               @id @default(cuid())
  tenantId            String
  unitId              String
  monthlyRent         Decimal              @db.Decimal(12, 2)
  dueDay              Int
  moveInDate          DateTime
  leaseStart          DateTime
  leaseEnd            DateTime?
  securityDeposit     Decimal?             @db.Decimal(12, 2)
  status              TenancyStatus        @default(ACTIVE)
  endedAt             DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              TenantProfile        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  rentCharges         RentCharge[]
  maintenanceRequests MaintenanceRequest[]
  documents           Document[]
  invitations         Invitation[]

  @@index([tenantId, status])
  @@index([unitId, status])
}

model RentCharge {
  id            String         @id @default(cuid())
  tenancyId     String
  billingMonth  DateTime       @db.Date
  amount        Decimal        @db.Decimal(12, 2)
  dueDate       DateTime       @db.Date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenancy       Tenancy        @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  payments      Payment[]
  notifications Notification[]

  @@unique([tenancyId, billingMonth])
  @@index([dueDate])
}

model Payment {
  id           String        @id @default(cuid())
  rentChargeId String
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime
  method       PaymentMethod
  referenceId  String?
  notes        String?
  createdAt    DateTime      @default(now())
  rentCharge   RentCharge    @relation(fields: [rentChargeId], references: [id], onDelete: Restrict)

  @@index([rentChargeId, paidAt])
}

model MaintenanceRequest {
  id          String                     @id @default(cuid())
  tenancyId   String
  category    MaintenanceCategory
  title       String
  description String
  priority    MaintenancePriority        @default(NORMAL)
  status      MaintenanceStatus          @default(SUBMITTED)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  tenancy     Tenancy                    @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  attachments MaintenanceAttachment[]
  history     MaintenanceStatusHistory[]

  @@index([tenancyId, status])
}

model MaintenanceAttachment {
  id         String             @id @default(cuid())
  requestId  String
  storageKey String
  fileName   String
  mimeType   String
  createdAt  DateTime           @default(now())
  request    MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model MaintenanceStatusHistory {
  id        String             @id @default(cuid())
  requestId String
  status    MaintenanceStatus
  note      String?
  createdAt DateTime           @default(now())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Document {
  id              String           @id @default(cuid())
  tenancyId       String
  category        DocumentCategory
  name            String
  storageKey      String
  mimeType        String
  size            Int
  visibleToTenant Boolean          @default(true)
  createdAt       DateTime         @default(now())
  tenancy         Tenancy          @relation(fields: [tenancyId], references: [id], onDelete: Restrict)

  @@index([tenancyId, category])
}

model Invitation {
  id        String           @id @default(cuid())
  tenancyId String
  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  tenancy   Tenancy          @relation(fields: [tenancyId], references: [id], onDelete: Restrict)

  @@index([tenancyId, status])
}

model Notice {
  id          String       @id @default(cuid())
  ownerId     String
  propertyId  String
  title       String
  body        String
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  owner       OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([propertyId, publishedAt])
}

model Notification {
  id           String             @id @default(cuid())
  rentChargeId String?
  channel      String
  kind         String
  recipient    String
  payload      Json
  status       NotificationStatus @default(PENDING)
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime           @default(now())
  rentCharge   RentCharge?        @relation(fields: [rentChargeId], references: [id], onDelete: Restrict)

  @@index([status, scheduledFor])
}

model ActivityLog {
  id          String       @id @default(cuid())
  ownerId     String
  actorUserId String?
  type        String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime     @default(now())
  owner       OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, createdAt])
}
